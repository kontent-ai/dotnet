@model ViewAsset
<img-asset asset="@Model" class="img-responsive" default-width="300" format="ImageFormat.Webp" quality="85" fit="ImageFitMode.Crop" auto-format="true" compression="ImageCompression.Lossless">
  <media-condition min-width="769" image-width="300" />
  <media-condition min-width="330" max-width="768" image-width="689" />
</img-asset>
