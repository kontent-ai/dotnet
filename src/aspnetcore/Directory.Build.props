<Project>
  <!-- Import the repo-wide settings first. Without this, MSBuild would stop here
       when walking up from a project and the root file would never apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Declared in eng/Versions.props, which the root Directory.Build.props imports. -->
    <Version>$(AspNetCoreVersion)</Version>
    <PackageProjectUrl>https://github.com/kontent-ai/dotnet/tree/main/src/aspnetcore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>kontent-ai-k-icon-color.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- $(MSBuildThisFileDirectory) resolves to src/aspnetcore/ regardless of how deep
         the consuming project sits, so these survive any future nesting changes. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)kontent-ai-k-icon-color.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
