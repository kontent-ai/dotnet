<Project>
  <!-- Import the repo-wide settings first. Without this, MSBuild would stop here
       when walking up from a project and the root file would never apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Declared in eng/Versions.props, which the root Directory.Build.props imports.
         The CLI tool and its Core library ship in lockstep on this one number. -->
    <Version>$(ModelGeneratorVersion)</Version>
    <PackageProjectUrl>https://github.com/kontent-ai/dotnet/tree/main/src/model-generator</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>tool;kontent-ai;generator</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GenerateDocumentationFile stays on - IDE0005 (unnecessary usings) only runs at
         build time when it is - but the members are not documented yet, so the
         missing-doc warning is silenced rather than the doc file switched off. -->
    <!-- slopwatch-ignore: SW005 The generator has never shipped XML docs (284 members). Writing them is its own change; turning the doc file off instead would silently disable IDE0005. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly so Directory.Packages.props decides the version (10.2.0).
         The published Kontent.Ai.Management 9.0.0-beta-4 asks for Refit 10.1.6, whose author
         certificate is revoked (NU3012). Highest-wins would still land on the 10.2.0 that
         Delivery 19.4.0 requires, but NuGet downloads and verifies 10.1.6 while walking the
         graph and fails there first - so the bad version has to be kept out of the graph, not
         just out of the result. A direct reference does that; transitive pinning is not usable
         here because it also drags Roslyn down to delivery's 4.9.2 entry and conflicts (NU1107).
         AddManagementClient's overloads also expose RefitSettings, so Refit is a real
         compile-time dependency of the CLI regardless.
         Remove both once Management ships a build that asks for 10.2.0. -->
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />

    <!-- $(MSBuildThisFileDirectory) resolves to src/model-generator/ regardless of how
         deep the consuming project sits, so this survives the src/ + test/ nesting. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
