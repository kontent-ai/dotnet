<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Include="$(KontentCommonPath)Http\HttpRetryPredicates.cs" Link="Common\HttpRetryPredicates.cs" />
    <Compile Include="$(KontentCommonPath)Http\SdkTrackingHeaders.cs" Link="Common\SdkTrackingHeaders.cs" />
    <Compile Include="$(KontentCommonPath)Http\HttpRetryDelay.cs" Link="Common\HttpRetryDelay.cs" />
    <Compile Include="$(KontentCommonPath)Http\RefitResponses.cs" Link="Common\RefitResponses.cs" />
    <Compile Include="$(KontentCommonPath)Http\RefitErrorParsing.cs" Link="Common\RefitErrorParsing.cs" />
    <Compile Include="$(KontentCommonPath)Http\HttpClientDefaults.cs" Link="Common\HttpClientDefaults.cs" />
    <Compile Include="$(KontentCommonPath)Http\HttpClientTimeouts.cs" Link="Common\HttpClientTimeouts.cs" />
    <Compile Include="$(KontentCommonPath)Http\ResilienceHandlers.cs" Link="Common\ResilienceHandlers.cs" />
    <Compile Include="$(KontentCommonPath)Http\DefaultResilience.cs" Link="Common\DefaultResilience.cs" />
    <Compile Include="$(KontentCommonPath)CompositeDisposable.cs" Link="Common\CompositeDisposable.cs" />
    <Compile Include="$(KontentCommonPath)FatalExceptions.cs" Link="Common\FatalExceptions.cs" />
    <Compile Include="$(KontentCommonPath)NamedClients.cs" Link="Common\NamedClients.cs" />
    <Compile Include="$(KontentCommonPath)KeyedClients.cs" Link="Common\KeyedClients.cs" />
    <Compile Include="$(KontentCommonPath)OptionsAccessor.cs" Link="Common\OptionsAccessor.cs" />
    <Compile Include="$(KontentCommonPath)OptionsRegistration.cs" Link="Common\OptionsRegistration.cs" />
    <Compile Include="$(KontentCommonPath)OptionsCopier.cs" Link="Common\OptionsCopier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Company>Kontent s.r.o.</Company>
    <PackageId>Kontent.Ai.Sync</PackageId>
    <Description>Official .NET SDK for Kontent.ai Sync API v2 - Efficiently synchronize content changes from your Kontent.ai projects</Description>
    <PackageTags>kontent-ai;sync;cms;api;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kontent.Ai.Sync.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
