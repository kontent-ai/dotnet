<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Company>Kontent s.r.o.</Company>
		<Description>Kontent.ai Management SDK</Description>
		<PackageTags>kontent-ai;kontent;sdk;management-api;content-management;cms;headless-cms</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
		<PackageReference Include="Refit" />
		<PackageReference Include="Refit.HttpClientFactory" />
	</ItemGroup>

	<ItemGroup>
		<!-- HttpRetryDelay is deliberately not included: this SDK leaves Retry-After to the
		     built-in ShouldRetryAfterHeader. See ConfigureDefaultResilience. -->
		<Compile Include="$(KontentCommonPath)Http\HttpRetryPredicates.cs" Link="Common\HttpRetryPredicates.cs" />
		<Compile Include="$(KontentCommonPath)Http\SdkTrackingHeaders.cs" Link="Common\SdkTrackingHeaders.cs" />
		<Compile Include="$(KontentCommonPath)Http\RefitResponses.cs" Link="Common\RefitResponses.cs" />
		<Compile Include="$(KontentCommonPath)Http\RefitErrorParsing.cs" Link="Common\RefitErrorParsing.cs" />
		<Compile Include="$(KontentCommonPath)FatalExceptions.cs" Link="Common\FatalExceptions.cs" />
		<Compile Include="$(KontentCommonPath)NamedClients.cs" Link="Common\NamedClients.cs" />
		<Compile Include="$(KontentCommonPath)OptionsCopier.cs" Link="Common\OptionsCopier.cs" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Kontent.Ai.Management.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
