<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Company>Kontent s.r.o.</Company>
    <Description>Kontent.ai Delivery SDK - Caching</Description>
    <PackageTags>kontent-ai;caching;fusioncache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kontent.Ai.Delivery\Kontent.Ai.Delivery.csproj" />
  </ItemGroup>

  <!-- No $(KontentCommonPath) includes on purpose: this package already sees Kontent.Ai.Delivery's
       internals through InternalsVisibleTo, which brings the shared types with it, and a second copy
       would be CS0436-ambiguous at every use.

       Accepted trade-off: Delivery packs as a floor, so a consumer holding this package back while
       moving Delivery forward gets a MissingMethodException at the first cache call. All five
       Delivery packages ship together from one DeliveryVersion, so it takes deliberate effort. -->

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kontent.Ai.Delivery.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
