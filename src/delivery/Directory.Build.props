<Project>
  <!-- Import the repo-wide settings first. Without this, MSBuild would stop here
       when walking up from a project and the root file would never apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Declared in eng/Versions.props, which the root Directory.Build.props imports.
         All five Delivery packages ship in lockstep on this one number. -->
    <Version>$(DeliveryVersion)</Version>
    <PackageProjectUrl>https://github.com/kontent-ai/dotnet/tree/main/src/delivery</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
