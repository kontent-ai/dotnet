<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Company>Kontent s.r.o.</Company>
    <Description>Kontent.ai Delivery SDK</Description>
    <PackageTags>kontent-ai;mvc;aspnet;aspnetmvc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <!-- Refit builds request logic at compile time and treats the reflection builder as opt-in.
         IDeliveryApi cannot be fully generated: the filter DSL travels as
         [Query] Dictionary<string, string[]>, whose keys are only known at runtime (RF006 names
         the seven methods). Without this reference RestService.For throws for that interface.

         Management and Sync generate completely and deliberately do NOT reference this.

         Dropping it means giving IDeliveryApi a generator-friendly shape for filters, which
         changes how query strings are built - a wire-level change, not a mechanical one. That
         also unblocks NativeAOT and trimming for Delivery. -->
    <PackageReference Include="Refit.Reflection" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kontent.Ai.Delivery.Abstractions\Kontent.Ai.Delivery.Abstractions.csproj" />
    <ProjectReference Include="..\Kontent.Ai.Urls\Kontent.Ai.Urls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kontent.Ai.Delivery.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kontent.Ai.Delivery.Caching</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
