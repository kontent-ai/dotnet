<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Company>Kontent s.r.o.</Company>
    <Description>Kontent.ai Delivery SDK - Source Generator for Content Type Registry. Emits ContentTypeCodenameAttribute for marking model classes.</Description>
    <PackageTags>kontent-ai;source-generation;roslyn;analyzer</PackageTags>

    <!-- Analyzer/Generator packaging -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols> <!-- PDBs are embedded directly in nupkg -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS2008;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately NOT the repo-wide version: this decides the OLDEST compiler that can load
         the generator. A host older than the Roslyn it was compiled against refuses it with
         CS9057, silently emitting nothing. 4.9.2 loads in every SDK from .NET 8.0.2xx onward.
         Raise it only for a newer Roslyn API, and treat that as a consumer-visible change. -->
    <!-- slopwatch-ignore: SW006 The central version is what every other project should use; this one project must NOT follow it. The compiled generator hard-references whatever Roslyn it was built against, and a host older than that skips it with CS9057 and emits nothing. Bypassing CPM here is the point, not an oversight. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.9.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack generator DLL into analyzers folder -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

</Project>
