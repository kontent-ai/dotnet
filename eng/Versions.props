<Project>
  <!-- Single source of truth for shipped versions; one property per product, inherited via
       src/<product>/Directory.Build.props. Bump with eng/scripts/update-version.cs or the
       Prepare release workflow; Publish ships whatever is declared here and not yet on nuget.org,
       tagging <product>-v<version> itself. -->
  <PropertyGroup>
    <DeliveryVersion>20.0.0-rc.3</DeliveryVersion>
    <SyncVersion>2.0.0-rc.3</SyncVersion>
    <ManagementVersion>9.0.0-rc.3</ManagementVersion>
    <AspNetCoreVersion>1.0.0-rc.2</AspNetCoreVersion>
    <ModelGeneratorVersion>11.0.0-rc.3</ModelGeneratorVersion>
  </PropertyGroup>
</Project>
