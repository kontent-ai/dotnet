<Project>
  <!-- Single source of truth for shipped versions; one property per product, inherited via
       src/<product>/Directory.Build.props. Bump with eng/scripts/update-version.cs, then tag
       <product>-v<version> - the release workflow refuses to publish if the two disagree. -->
  <PropertyGroup>
    <DeliveryVersion>20.0.0-rc.2</DeliveryVersion>
    <SyncVersion>2.0.0-rc.2</SyncVersion>
    <ManagementVersion>9.0.0-rc.2</ManagementVersion>
    <AspNetCoreVersion>1.0.0-rc.2</AspNetCoreVersion>
    <ModelGeneratorVersion>11.0.0-rc.2</ModelGeneratorVersion>
  </PropertyGroup>
</Project>
