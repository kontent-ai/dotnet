<Project>
  <!-- Single source of truth for shipped package versions.
       One property per product; every project in that product inherits it via
       src/<product>/Directory.Build.props.

       To release: bump the property here (eng/scripts/update-version.cs does it and
       promotes the changelog), merge, then tag <product>-v<version>. The release
       workflow refuses to publish if the tag and the property disagree. -->
  <PropertyGroup>
    <DeliveryVersion>19.4.0</DeliveryVersion>
    <SyncVersion>1.0.0</SyncVersion>
    <ManagementVersion>9.0.0-beta-5</ManagementVersion>
    <AspNetCoreVersion>0.17.0-preview.1</AspNetCoreVersion>
    <ModelGeneratorVersion>10.3.0-beta-1</ModelGeneratorVersion>
  </PropertyGroup>
</Project>
