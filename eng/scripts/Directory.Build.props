<Project>
  <!-- Deliberately does NOT import the repo-root Directory.Build.props: metadata, SourceLink and
       analyzers apply to products, not tooling. Practical rather than tidy - `dotnet run` writes
       build diagnostics to stdout, so an analyzer warning here corrupts a script's output.
       Language settings are repeated rather than inherited. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
