<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- `clear` so a developer's global sources cannot silently satisfy a reference from
         nuget.org that should have come from the local feed. -->
    <clear />
    <add key="smoke-feed" value="../../artifacts/smoke-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
